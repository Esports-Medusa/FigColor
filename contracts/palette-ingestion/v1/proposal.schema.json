{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://figcolor.local/contracts/palette-ingestion/v1/proposal.schema.json",
  "title": "FigColor Palette Ingestion Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "batch_id", "source_key", "source_hash", "pipeline_version", "schema_version", "normalized_content_hash", "colors", "palette", "preview_case_suggestions", "internal_evidence", "validation"],
  "properties": {
    "proposal_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "source_key": {"type": "string"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pipeline_version": {"type": "string"},
    "schema_version": {"const": 1},
    "normalized_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provisional_id", "hex", "order", "method", "requires_review"],
        "properties": {
          "provisional_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$"},
          "hex": {"type": "string", "pattern": "^#[0-9A-F]{6}$"},
          "order": {"type": "integer", "minimum": 0},
          "method": {"const": "supplied"},
          "requires_review": {"type": "boolean"}
        }
      }
    },
    "palette": {"$ref": "#/$defs/proposalPalette"},
    "preview_case_suggestions": {"type": "array", "items": {"$ref": "ingestion-request.schema.json#/$defs/previewCase"}},
    "internal_evidence": {"type": "object", "additionalProperties": true},
    "validation": {"$ref": "validation-report.schema.json"}
  },
  "$defs": {
    "suggestedString": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "method", "requires_review"],
      "properties": {"value": {"type": "string"}, "method": {"enum": ["supplied", "deterministic"]}, "requires_review": {"type": "boolean"}}
    },
    "suggestedStrings": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "method", "requires_review"],
      "properties": {"value": {"type": "array", "items": {"type": "string"}}, "method": {"const": "supplied"}, "requires_review": {"type": "boolean"}}
    },
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["chart_type", "suitability", "source"],
      "properties": {"chart_type": {"type": "string"}, "suitability": {"enum": ["best_fit", "recommended", "compatible", "limited"]}, "notes": {"type": "string", "maxLength": 1000}, "source": {"const": "curated"}}
    },
    "proposalPalette": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "disciplines", "use_cases", "avoid_cases", "tags", "chart_applicability"],
      "properties": {
        "name": {"$ref": "#/$defs/suggestedString"},
        "type": {"$ref": "#/$defs/suggestedString"},
        "disciplines": {"$ref": "#/$defs/suggestedStrings"},
        "use_cases": {"$ref": "#/$defs/suggestedStrings"},
        "avoid_cases": {"$ref": "#/$defs/suggestedStrings"},
        "tags": {"$ref": "#/$defs/suggestedStrings"},
        "chart_applicability": {
          "type": "object", "additionalProperties": false,
          "required": ["value", "method", "requires_review"],
          "properties": {"value": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/applicability"}}, "method": {"const": "supplied"}, "requires_review": {"type": "boolean"}}
        }
      }
    }
  }
}
